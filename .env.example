# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_NASA_API_KEY: api.nasa.gov key for DONKI space-weather requests.
# Get a free key at https://api.nasa.gov/ (DEMO_KEY fallback: 30 req/hr, 50/day).
VITE_NASA_API_KEY="MY_NASA_API_KEY"

# VITE_GEMINI_API_KEY: enables live AI explanations in the Explainability panel.
# Browser-side key per the AI Studio scaffold pattern — use a RESTRICTED,
# disposable key for demos; proxy through a backend before any real deployment.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
